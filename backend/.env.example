# Required backend configuration. Replace every value before startup.
DATABASE_URL=
JWT_SECRET_KEY=
AGENT_AUTH_TOKEN=

# Comma-separated exact frontend origins, without paths or wildcards.
# Production example: https://your-app.vercel.app
# Include every trusted Vercel custom domain that should use cookie sessions.
ALLOWED_ORIGINS=

# Optional email delivery configuration.
SMTP_EMAIL=
SMTP_PASSWORD=
